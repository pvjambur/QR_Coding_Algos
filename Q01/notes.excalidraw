    {
      "id": "prPyGTo12KiuskF4GCoM5",
      "type": "text",
      "x": 771.7899627685547,
      "y": 1012.5,
      "width": 372.27978515625,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
