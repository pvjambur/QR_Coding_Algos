    {
      "id": "3IhmEUmyb9KZig8AwpJsC",
      "type": "text",
      "x": 777.3899536132812,
      "y": 1819.8999938964844,
      "width": 382.35913085937494,
      "height": 150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
