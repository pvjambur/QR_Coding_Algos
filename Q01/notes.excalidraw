      "versionNonce": 588313941,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795548646734,
      "link": null,
      "locked": false,
      "text": "A full house is a 5-card hand\ncontaining three cards of one rank and\ntwo cards of another rank.\n\nExample: K♠ K♥ K♦ 7♣ 7♠ —\nthree Kings + a pair of 7s.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A full house is a 5-card hand containing three cards of one rank and two cards of another rank.\n\nExample: K♠ K♥ K♦ 7♣ 7♠ — three Kings + a pair of 7s.",
      "autoResize": false,
      "lineHeight": 1.25
    },
