      "index": "ac",
      "roundness": null,
      "seed": 174568006,
      "version": 425,
      "versionNonce": 279906970,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795547897359,
      "link": null,
      "locked": false,
      "text": "Counting principles:\n\nMultiplication rule: If we have an\n    experiment with n possible\n    outcomes, and we do a second\n    experiment such that for\n    each outcome of 1st experiment\n    there are n2 outcomes for the \n    2nd experiment and ..... so on,\n\n    For each tere are nr outcomes\n    for the rth experiment, then\n    overall we have:\n\n    (n1 + n2 ... + nr) possible outcomes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Counting principles:\n\nMultiplication rule: If we have an\n    experiment with n possible\n    outcomes, and we do a second\n    experiment such that for\n    each outcome of 1st experiment\n    there are n2 outcomes for the \n    2nd experiment and ..... so on,\n\n    For each tere are nr outcomes\n    for the rth experiment, then\n    overall we have:\n\n    (n1 + n2 ... + nr) possible outcomes",
      "autoResize": true,
      "lineHeight": 1.25
    },
